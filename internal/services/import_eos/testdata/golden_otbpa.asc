! Fixture Patch
! $Patch channel number, personality number, patch address,
!                 address mode (1=display as port/offset,
!                               0=display as edmx
!                 part
!    $$Pers       personality name
!    Text         label
!    $$SetScroller <parameter number> <scroller number>
!     $$PersSlot  scroller calibration data
!    $$Proportion proportion (0-200%)
!    $$Curve      curve number (9999.999 max) parameter number (default=1) 
!    $$FanCurve   fan curve number (9999.999 max, default=none)
!    $$ShutterOrder (default=1 2 3 4)
!    $$Preheat    preheat level (0-100%) or "Preset"
!    $$ColorPath  color path number (1-9999, default=none)
!    $$SACNPriority single channel priority(1-200, default=none)
!    $$Options    P=flip pan T=flip tilt S=swap pan and tilt X=GM Exempt
!                 R=flip rack L=disable LD flags (default=none)
!    $$Text01     <Text 1>
!    [...]
!    $$Text10     <Text 10>
!    $$TextGel    <Gel Text>
!    $$Notes      <Notes Text>
!    $$Position     <x y z>
!    $$Orientation  <x y z>
!    $$Data         <3D Attributes>
 
